{
  "type": "module",
  "name": "abba-360",
  "version": "2.0.0",
  "description": "ABBA-360: Agnostic Browser-Based Research Sandbox Architecture for AI Sound-Generation in Networks of 360 Images",
  "main": "server.js",
  "plugins": [
    "jsdoc-babel"
  ],
  "dependencies": {
    "@gradio/client": "^2.2.0",
    "axios": "^1.15.2",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "fs-extra": "^11.1.1",
    "pako": "^2.1.0",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.3"
  },
  "scripts": {
    "start": "node server.js",
    "docs:client": "jsdoc2md --configure ./helper_scripts/jsdoc.json \"./client/js/**/*.js\" \"./*.js\"> ./docs/CLIENT_DOCS.md",
    "docs:server": "jsdoc2md --configure ./helper_scripts/jsdoc.json \"./server/**/*.js\" \"./*.js\" > ./docs/SERVER_DOCS.md",
    "docs": "npm run docs:client && npm run docs:server && node ./helper_scripts/fix-mermaid.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "jsdoc-babel": "^0.5.0",
    "jsdoc-to-markdown": "^9.1.3"
  }
}